PORT=7000

# MEGA.nz credentials
MEGA_EMAIL=your@email.com
MEGA_PASSWORD=yourpassword

# Optional: root folder name to start scanning from (leave empty to scan entire account root)
MEGA_ROOT_FOLDER=

# Optional: path for the SQLite database file (default: data.db in project root)
DB_PATH=

# Secret token used as URL prefix to protect streaming endpoints
USER_TOKEN=

# Optional: external base URL of this server (default: http://localhost:PORT)
# Set this when running behind a reverse proxy or tunnel
BASE_URL=
